APP_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes

DATABASE_URL=postgresql://rebuild:rebuild@postgres:5432/rebuild

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

S3_ENDPOINT=http://object-store:9000
S3_REGION=auto
S3_BUCKET=rebuild-loop
S3_ACCESS_KEY=rebuild
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_FORCE_PATH_STYLE=true

WEB_PORT=3000
WORKER_HEALTH_PORT=3001
POSTGRES_PORT=55434
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
