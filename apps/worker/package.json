{
  "name": "@rebuild/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:sharp --outfile=dist/index.js",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rebuild/analysis": "workspace:*",
    "@rebuild/db": "workspace:*",
    "@rebuild/kernel": "workspace:*",
    "@rebuild/storage": "workspace:*",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
