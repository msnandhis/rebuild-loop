{
  "name": "rebuild-loop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "adk:run": "pnpm --filter @rebuild/adk dev",
    "adk:web": "pnpm --filter @rebuild/adk web",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "docker:config": "docker compose -f compose.dev.yaml config --quiet && docker compose -f compose.prod.yaml config --no-interpolate --quiet"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "6.0.3"
  }
}
